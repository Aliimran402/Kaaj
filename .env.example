# Copy this file to .env (next to pom.xml) and fill it in. Never commit .env (it is git-ignored).
# Put comments on their own lines: text after a value becomes part of the value.

# The Docker database (compose.yaml). Any password you like: Docker creates the database with it the first time.
DB_PASSWORD=change-me

# Secret for hashing the 6-digit email codes: any random text of 16+ characters
KAAJ_CODE_SECRET=change-me-to-16-or-more-random-characters

# The first admin account, created at startup when no admin exists yet (password: 8+ characters)
KAAJ_ADMIN_EMAIL=admin@kaaj.local
KAAJ_ADMIN_PASSWORD=Admin@12345

# Optional: where uploaded documents (trade licences, NIDs) are kept. Default: data/uploads (git-ignored)
# KAAJ_FILES_DIR=data/uploads

# Google sign-in (optional in dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail for sending codes (not needed with the dev profile: codes are printed in the terminal)
MAIL_USERNAME=
MAIL_APP_PASSWORD=
